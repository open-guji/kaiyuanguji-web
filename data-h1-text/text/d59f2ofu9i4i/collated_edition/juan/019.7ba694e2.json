    {
      "title": "祖冲之　安邊論",
      "level": 3,
      "type": "book",
      "paragraphs": [
        {
          "text": "轉長水校尉，領本職。冲之造《安邊論》，欲開屯田，廣農殖。建武中，明帝使冲之巡行四方，興造大業，可以利百姓者，會連有軍事，事竟不行。",
          "source": "《南齊書》五二《祖冲之傳》、《南史》七二《文学·祖冲之傳》。"
        }
      ],
      "author": "祖冲之",
      "work_id": "d59f8ii4unsw"
    }
  ]
