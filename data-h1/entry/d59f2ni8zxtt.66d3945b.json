{"schema_version":1,"id":"d59f2ni8zxtt","type":"work","title":"召對錄","authors":[{"name":"申時行","role":"撰","dynasty":"明","entity_id":"hixhd2h9bdxy"}],"indexed_by":[{"source":"欽定四庫全書總目","source_bid":"d59dh3vo9af4","title_info":"《召對錄》•一卷","author_info":"明申時行撰","summary":"明申時行撰。時行有《書經講義會編》，已著錄。此書乃記萬曆十三年五月迄十八年七月召對之語。時行時為首輔，六年中凡召對九次。當神宗怠政之際，君臣否隔，萬事叢脞。時行不能匡救，乃反謂孝宗後此典久廢不舉，至是複行。沾沾誇為盛事，過矣！","edition":"內府藏本"},{"source":"國史經籍志","source_bid":"d59f2nl40936","title_info":"《召對錄》一卷","summary":"《召對錄》一卷（李時）","author_info":"李時"},{"source":"續修四庫全書","source_bid":"d59f2og4vksh","title_info":"《召對錄》一卷","author_info":"明申時行撰","summary":"《召對錄》一卷。明申時行撰。影印上海圖書館藏明萬曆刻本。","edition":"影印上海圖書館藏明萬曆刻本","volume":"第434冊","section":"史部 史部"},{"source":"四庫全書存目叢書","source_bid":"d59f2og4vke9","title_info":"《召對錄》一卷","author_info":"明申時行撰","summary":"《召對錄》一卷。明申時行撰。南京圖書館藏明萬曆刻本。","edition":"南京圖書館藏明萬曆刻本","volume":"第49冊","section":"史部"}],"juan_count":{"number":1},"resources":[{"id":"wikisource","name":"维基文库","url":"https://zh.wikisource.org/wiki/召對錄","types":["text"]},{"id":"shidianguji-wanlishenshishangbai","name":"识典古籍","url":"https://www.shidianguji.com/book/HY6354","metadata":{"edition":"萬曆沈氏尚白齋刻本","version":"v8","total_page":74,"paragraph_count":55,"has_translation":true,"check_type":"粗校"},"types":["text","image"]},{"id":"shidianguji-wanlikeben","name":"识典古籍","url":"https://www.shidianguji.com/book/CADAL02081819","metadata":{"edition":"萬曆刻本","version":"v3","total_page":73,"paragraph_count":49,"has_translation":true,"check_type":"粗校"},"types":["text","image"]},{"id":"shidianguji-keben","name":"识典古籍","url":"https://www.shidianguji.com/book/CADAL02047780","metadata":{"edition":"刻本","version":"v3","total_page":74,"paragraph_count":45,"has_translation":true,"check_type":"粗校"},"types":["text","image"]},{"name":"Internet Archive","id":"internet-archive","url":"https://archive.org/details/02081819.cn","types":["image"]},{"id":"wikimedia-commons-xuxiu","name":"維基共享 續修四庫全書 PDF","short_name":"維基共享","url":"https://commons.wik