{"schema_version":1,"id":"d59f2nk51og0","type":"work","title":"三才圖會","authors":[{"name":"王圻","role":"撰","dynasty":"明","entity_id":"hixhd2h9bekn"}],"indexed_by":[{"source":"欽定四庫全書總目","source_bid":"d59dh3vo9af4","title_info":"《三才圖會》·一百六卷","author_info":"明王圻撰","summary":"明王圻撰。是書匯輯諸書圖譜，共為一編。凡天文四卷，地理十六卷，人物十四卷，時令四卷，宮室四卷，器用十二卷，身體七卷，衣服三卷，人事十卷，儀制八卷，珍寶二卷，文史四卷，鳥獸六卷，草木十二卷，采摭浩博，亦有足資考核者。而務廣貪多，冗雜特甚。其人物一門，繪畫古來名人形像，某甲某乙，宛如目睹，殊非徵信之道。如據倉頡四目之說，即畫一面有四目之人，尤近兒戲也。","edition":"浙江巡撫采進本"},{"source":"續修四庫全書","source_bid":"d59f2og4vksh","title_info":"《三才圖會》一百六卷","author_info":"明王圻","summary":"《三才圖會》一百六卷。明王圻。影印上海圖書館藏明萬曆三十五年刻本。","edition":"影印上海圖書館藏明萬曆三十五年刻本","volume":"第1234冊","section":"子部 類書"},{"source":"四庫全書存目叢書","source_bid":"d59f2og4vke9","title_info":"《三才圖會》一百六卷","author_info":"明王圻輯","summary":"《三才圖會》一百六卷。明王圻輯。北京大學圖書館藏明萬曆三十七年刻本。","edition":"北京大學圖書館藏明萬曆三十七年刻本","volume":"第184冊","section":"子部"}],"juan_count":{"number":106},"resources":[{"id":"shidianguji-wanliyuankanben","name":"识典古籍","url":"https://www.shidianguji.com/book/SDZJ0048","metadata":{"edition":"万历37年原刊本","version":"v7","total_page":350,"paragraph_count":303,"has_translation":true,"check_type":"粗校"},"types":["text","image"]},{"id":"shidianguji-wanlisanshiqikechong","name":"识典古籍","url":"https://www.shidianguji.com/book/HY7188","metadata":{"edition":"萬曆三十七年(1609)刻崇禎王爾賓重修本","version":"v32","total_page":9938,"paragraph_count":24543,"check_type":"AI整理"},"types":["text","image"]},{"name":"Internet Archive","id":"internet-archive","url":"https://archive.org/details/02098268.cn","types":["image"]},{"id":"wikimedia-commons-xuxiu","name":"維基共享 續修四庫全書 PDF","short_name":"維基共享","url":"https://commons.wikimedia.org/wiki/File:%E7%BA%8C%E4%BF%AE%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E7%AC%AC1234%E5%86%8A.pdf","metadata":{"volume":1234},"types":["image"]},{"name":"维基共享资源","type":"image","id":"commons","url":"https://commons.wikimedia.org/wiki/File:%E4%B8%89%E6%89%8D%E5%9C%96%E6%9C%83%28%E4%B8%80%29.djvu"}],"measures":[{"unit":"卷","number":106}],"measur