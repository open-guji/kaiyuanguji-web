# /etc/fulltext.env 模板（install.sh 只在文件不存在时复制本模板，权限 600，属主 root）。
# 这里全是非机密配置，没有令牌；真有机密类变量也只填在机器上，不进仓、不进卡。
FT_HOST=127.0.0.1
FT_PORT=8765
# 跟着 current 符号链接走：轮换只切链接，不改这里
FT_INDEX_DIR=/opt/fulltext/current/index
FT_TITLES=/opt/fulltext/current/titles.json
FT_BOOST=/opt/fulltext/current/boost.json
# book-text 检出目录（回映命中读章 md）。服务以 fulltext 用户跑、读不了 /root 下的目录，
# 所以要给它一份可读的只读检出（或对 /root/book-text 开 ACL）——由 Owen／Mason 在步 3 前定，见 部署清单.md §三
FT_TEXT_ROOT=/opt/fulltext/book-text
FT_CANDIDATES=400
FT_MAX_CONCURRENT=4
FT_QUEUE_MAX=8
FT_TIMEOUT_S=3.0
FT_LRU_BYTES=67108864
