# /etc/fulltext.env 模板（install.sh 只在文件不存在时复制本模板，权限 600，属主 root）。
# 这里全是非机密配置，没有令牌；真有机密类变量也只填在机器上，不进仓、不进卡。
FT_HOST=127.0.0.1
# 对公网开放给 EdgeOne 边缘函数时（GUJI-616）：FT_HOST=0.0.0.0，并在本机另填 FT_EDGE_TOKEN=<随机串>（机密，只填在机器上，
# 同一个值配到 EdgeOne 项目环境变量 FULLTEXT_TOKEN）。非本机来源不带对令牌一律 404；/healthz、/admin 对外一律 404。
FT_PORT=8765
# 跟着 current 符号链接走：轮换只切链接，不改这里
FT_INDEX_DIR=/opt/fulltext/current/index
FT_TITLES=/opt/fulltext/current/titles.json
FT_BOOST=/opt/fulltext/current/boost.json
# v2 起服务只读索引包（原文存在索引里），不需要 book-text 检出
FT_EXACT_SCAN=3000
FT_MAX_CONCURRENT=4
FT_QUEUE_MAX=8
FT_TIMEOUT_S=3.0
