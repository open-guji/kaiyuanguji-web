[Unit]
Description=开鉴古籍全文检索服务（F4，Tantivy）
After=network.target

[Service]
Type=simple
User=fulltext
Group=fulltext
EnvironmentFile=/etc/fulltext.env
WorkingDirectory=/opt/fulltext/app
ExecStart=/opt/fulltext/bin/run-service.sh
# 轮换时换了 current 符号链接，通知服务重开索引目录、清章缓存（reload 失败由 rotate.sh 改 restart）
ExecReload=/usr/bin/curl -fsS -X POST http://127.0.0.1:8765/admin/reload
Restart=on-failure
RestartSec=3
# 与 Meili 共机：内存软上限、低 CPU／IO 优先级（不设 MemoryMax，避免被 OOM 直接杀）
MemoryHigh=800M
Nice=10
IOSchedulingClass=idle
# 读盘硬上限（GUJI-615 实测：云盘调度器不认 idle 优先级，全文把盘读满、Meili 慢了约 10 倍）。
# 10-19 第二轮：30M／600 时九成查询超时（索引走 mmap，缺页是 4 KB 随机读，卡在 IOPS 上），放宽到 60M／2000。
# cgroup io.max 与调度器无关；写成路径时 systemd 自动换成它所在的块设备。宁可全文慢（3–5 秒可接受），不抢 Meili。
IOReadBandwidthMax=/opt/fulltext 60M
IOReadIOPSMax=/opt/fulltext 2000
# 基本加固
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadOnlyPaths=/opt/fulltext
# tantivy 打开索引要在索引目录里建 .tantivy-meta.lock；目录权限由 rotate.sh 设成只有 index/ 归 fulltext，
# 其余文件仍是 root 只读，这里只是让沙箱放行
ReadWritePaths=/opt/fulltext/releases

[Install]
WantedBy=multi-user.target
