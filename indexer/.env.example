# 复制为 .env 后填入真实值；.env 已在 .gitignore，不会被提交。
#
# 注意：这里用的是 **EdgeOne 国际版**（Tencent Cloud International）账号的凭证，
# 不是国内腾讯云那个。两套账号独立，凭证不通用。
# 国际版控制台：https://console.tencentcloud.com/
# 强烈建议建一个最小权限子账号，只授予 EdgeOne 节点缓存清除策略。

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
EDGEONE_ZONE_ID=

# 默认走国际版端点（kaiyuanguji.com 在 EdgeOne 国际版上）
# 如果哪天迁回国内 EdgeOne，改成 teo.tencentcloudapi.com
EDGEONE_ENDPOINT=teo.intl.tencentcloudapi.com

# 默认 api.kaiyuanguji.com，搜索 API 用这个
PURGE_HOST=api.kaiyuanguji.com
