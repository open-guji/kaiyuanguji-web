# 数据模式: local = 本地文件+本地库, remote = npm+GitHub 远程（默认）
# 本地模式需要先运行: bash scripts/setup-local.sh
NEXT_PUBLIC_MODE=remote

# 数据源: github | gitee | bundle | cos | local
# - bundle: 数据打包进 EdgeOne Pages 静态资源（旧模式，受 2 万文件限制）
# - cos:    数据走独立 data.kaiyuanguji.com → 新加坡 COS（推荐，无文件数限制）
# NEXT_PUBLIC_DATA_SOURCE=cos

# COS 数据 CDN 域名（DATA_SOURCE=cos 时必填）
# 浏览器先 fetch ${COS_BASE}/latest.json 拿 commitId，再拼 ${COS_BASE}/v/{commit}/...
# NEXT_PUBLIC_COS_BASE=https://data.kaiyuanguji.com

# Phase 1 Hybrid 搜索（可选）
# 留空时只走 L2（worker 索引），等同未启用
# 配置后启用 L1（Meilisearch on 上海云），L1 失败时自动 fallback L2
# DNS 切换前可用 IP 直连：http://122.51.91.177:7700
# DNS 切换后：https://api.kaiyuanguji.com
# NEXT_PUBLIC_MEILI_URL=
# NEXT_PUBLIC_MEILI_KEY=

# COS 上传凭据（只在跑 scripts/sync-to-cos.mjs 时需要，浏览器永远拿不到）
# 子用户 kyg-cos-sync 的 SecretId / SecretKey
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=kyg-data-1300xxxxxx
# COS_REGION=ap-shanghai

# ── 以下键 .env.local 里实际在用，此前未列入本文件（2026-09-06 补）──
# dev 本地数据 API（NEXT_PUBLIC_MODE=local 时）读三个数据仓的父目录；scripts/setup-local.sh 会写好
# BOOK_INDEX_WORKSPACE_ROOT=D:/workspace
# 打包脚本 scripts/bundle-data.mjs / build-search-index.mjs 的数据仓路径覆盖（默认相对 ../..）
# BOOK_INDEX_DRAFT_DIR=D:/workspace/book-index-draft
# BOOK_INDEX_PRODUCTION_DIR=D:/workspace/book-index
# BOOK_TEXT_DIR=D:/workspace/book-text
# 手动 purge EdgeOne 缓存时用（CI 从 secrets 取；该子账号只有 EdgeOne purge 权限，无 CVM 权限）
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# EDGEONE_ZONE_ID=
