# /etc/search-api.env（权限 600，root 持有）——值由 Deploy 从 guji-dev-secret 取，别提交真值
PORT=7710
HOST=0.0.0.0
SEARCH_API_KEY=<与边缘函数 SEARCH_PG_KEY 相同的随机串>
SEARCH_PG_SCHEMA=search
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=guji
PGUSER=search_ro
PGPASSWORD=<search_ro 密码>
PG_POOL=4
PG_STATEMENT_TIMEOUT_MS=2000
MAX_QUEUE=32
